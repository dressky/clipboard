{
  "manifest_version": 3,
  "name": "Clipboard - Local & Private",
  "version": "1.2.0",
  "description": "Локальный буфер обмена для текста, фото и видео. Данные хранятся на вашем диске и никуда не отправляются.",
  "homepage_url": "https://github.com/dressky/clipboard",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "contextMenus",
    "clipboardRead",
    "clipboardWrite",
    "activeTab",
    "tabs",
    "scripting",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "ui/panel.html",
    "default_title": "Clipboard",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "ui/panel.html"
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/content-script.js"
      ],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/icon-16.png",
        "icons/icon-32.png",
        "icons/icon-48.png",
        "icons/icon-128.png",
        "icons/pixel/png/*",
        "fonts/Tiny5Mono-Regular.woff2",
        "fonts/Tiny5Mono-Bold.woff2"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "commands": {
    "toggle-clipboard": {
      "suggested_key": {
        "default": "Alt+V",
        "mac": "Alt+V"
      },
      "description": "Открыть Clipboard"
    }
  },
  "minimum_chrome_version": "114"
}
